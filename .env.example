NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
YOUCAM_API_KEY=
YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
# Groq Free plan: https://console.groq.com/keys (quota-limited; keep billing off).
GROQ_API_KEY=
# Preview model: confirm availability in your Groq account.
GROQ_MODEL=qwen/qwen3.8-27b
# Groq-hosted open-weight model with built-in browser search; same Groq key.
GROQ_WEB_SEARCH_MODEL=openai/gpt-oss-20b
# Optional alternative compatible provider; no paid endpoint is selected by default.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Enable only after verifying YouCam storage/retention terms.
HISTORY_RETENTION_ENABLED=false
# Enable external LLM use only after reviewing provider data terms.
LLM_DATA_SHARING_ENABLED=false
IMAGE_RETENTION_HOURS=24
CRON_SECRET=
# Demo is local, synthetic, and never calls a real analysis provider.
NEXT_PUBLIC_DEMO_ENABLED=true
